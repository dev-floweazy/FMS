<?xml version="1.0" encoding="utf-8"?>
<odoo>
 <!-- ============================================ -->
    <!-- SERVICE CATEGORY VIEWS -->
    <!-- ============================================ -->

    <record id="view_fms_service_category_list" model="ir.ui.view">
        <field name="name">fms.service.category.list</field>
        <field name="model">fms.service.category</field>
        <field name="arch" type="xml">
            <list string="Service Categories">
                <field name="name"/>
                <field name="code"/>
                <field name="parent_id"/>
                <field name="default_sla_hours"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_fms_service_category_form" model="ir.ui.view">
        <field name="name">fms.service.category.form</field>
        <field name="model">fms.service.category</field>
        <field name="arch" type="xml">
            <form string="Service Category">
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="bg-danger" invisible="active"/>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="code"/>
                            <field name="parent_id"/>
                        </group>
                        <group>
                            <field name="default_sla_hours"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Services" name="services">
<!--                            domain="[('is_fms_service', '=', True)]"-->
                            <field name="product_ids" >
                                <list>
                                    <field name="name"/>
                                    <field name="default_code"/>
                                    <field name="uom_id"/>
                                    <field name="standard_price"/>
                                    <field name="list_price"/>
                                </list>
                            </field>
                        </page>attr
                        <page string="Sub-Categories" invisible="not child_ids">
                            <field name="child_ids">
                                <list>
                                    <field name="name"/>
                                    <field name="code"/>
                                    <field name="default_sla_hours"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

      <record id="action_fms_service_category" model="ir.actions.act_window">
        <field name="name">Service Categories</field>
        <field name="res_model">fms.service.category</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first service category
            </p>
            <p>
                Service categories help organize services and define SLA rules.
            </p>
        </field>
    </record>
</odoo>