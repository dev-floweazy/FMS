<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- FMS JOB VIEWS -->
    <!-- ============================================ -->

    <!-- Job List View -->
    <record id="view_fms_job_list" model="ir.ui.view">
        <field name="name">fms.job.list</field>
        <field name="model">fms.job</field>
        <field name="arch" type="xml">
            <list string="Jobs" decoration-success="state=='completed'" decoration-info="state in ['assigned','scheduled']">
                <field name="name"/>
                <field name="ticket_id"/>
                <field name="partner_id"/>
                <field name="site_id"/>
                <field name="vendor_id"/>
                <field name="scheduled_date"/>
                <field name="total_cost" sum="Total Cost"/>
                <field name="total_price" sum="Total Price"/>
                <field name="margin" sum="Margin" decoration-danger="margin &lt; 0" decoration-success="margin &gt; 0"/>
                <field name="margin_percent" widget="percentage"/>
                <field name="state"/>
                <field name="currency_id" invisible="1"/>
            </list>
        </field>
    </record>

    <!-- Job Form View -->
    <record id="view_fms_job_form" model="ir.ui.view">
        <field name="name">fms.job.form</field>
        <field name="model">fms.job</field>
        <field name="arch" type="xml">
            <form string="Job">
<!--                <header>-->
<!--                    <button name="action_assign_vendor" string="Assign Vendor" type="object" states="draft" class="oe_highlight"/>-->
<!--                    <button name="action_schedule" string="Schedule" type="object" states="assigned" class="oe_highlight"/>-->
<!--                    <button name="action_start" string="Start Job" type="object" states="scheduled"/>-->
<!--                    <button name="action_complete" string="Mark Complete" type="object" states="in_progress" class="oe_highlight"/>-->
<!--                    <button name="action_create_sale_order" string="Create Sales Order" type="object" states="completed" attrs="{'invisible': [('sale_order_id', '!=', False)]}" class="oe_highlight"/>-->
<!--                    <button name="action_create_purchase_order" string="Create Vendor PO" type="object" states="completed" attrs="{'invisible': [('purchase_order_id', '!=', False)]}"/>-->
<!--                    <button name="action_create_invoice" string="Create Invoice" type="object" states="completed" attrs="{'invisible': ['|', ('sale_order_id', '=', False), ('invoice_id', '!=', False)]}" class="oe_highlight"/>-->
<!--                    <button name="action_cancel" string="Cancel" type="object" states="draft,assigned,scheduled" confirm="Cancel this job?"/>-->
<!--                    <field name="state" widget="statusbar" statusbar_visible="draft,assigned,scheduled,in_progress,completed,invoiced"/>-->
<!--                </header>-->
                <sheet>
                    <div class="oe_button_box" name="button_box">
<!--                        attrs="{'invisible': [('sale_order_id', '=', False)]}"-->
                        <button name="action_view_sale_order" type="object" class="oe_stat_button" icon="fa-shopping-cart" >
                            <field name="sale_order_id" widget="statinfo" string="Sales Order"/>
                        </button>
<!--                        attrs="{'invisible': [('purchase_order_id', '=', False)]}"-->
                        <button name="action_view_purchase_order" type="object" class="oe_stat_button" icon="fa-shopping-basket" >
                            <field name="purchase_order_id" widget="statinfo" string="Vendor PO"/>
                        </button>
<!--                        attrs="{'invisible': [('invoice_id', '=', False)]}"-->
                        <button name="action_view_invoice" type="object" class="oe_stat_button" icon="fa-file-text-o" >
                            <field name="invoice_id" widget="statinfo" string="Invoice"/>
                        </button>
                    </div>

                    <!-- Improved Job Number UI -->
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only"/>
                        <h1>
                            <field name="name"
                                   readonly="1"
                                   class="text-primary"
                                   widget="copyclipboard"
                                   placeholder="Job Number"/>
                        </h1>
                    </div>

                    <group>
                        <group>
                            <field name="ticket_id"/>
                            <field name="partner_id"/>
                            <field name="site_id"/>
                            <field name="service_category_id"/>
                        </group>
                        <group>
<!--                            domain="[('is_fms_vendor', '=', True)]"-->
                            <field name="vendor_id" />
                            <field name="assigned_user_id"/>
                            <field name="scheduled_date"/>
<!--                             attrs="{'readonly': [('state', 'not in', ['in_progress', 'completed'])]}"-->
                            <field name="start_date"/>
<!--                            attrs="{'readonly': [('state', '!=', 'completed')]}"-->
<!--                            attrs="{'readonly': [('state', '!=', 'completed')]}"-->
                            <field name="end_date" />
                        </group>
                    </group>

                    <notebook>
                        <page string="Job Details" name="job_lines">
                            <field name="job_line_ids">
                                <list editable="bottom">
<!--                                    <field name="product_id" domain="[('is_fms_service', '=', True)]"/>-->
                                    <field name="description"/>
                                    <field name="product_id"/>
                                    <field name="quantity"/>
                                    <field name="uom_id"/>
                                    <field name="unit_cost"/>
                                    <field name="subtotal_cost" sum="Total Cost"/>
                                    <field name="unit_price"/>
                                    <field name="subtotal_price" sum="Total Price"/>
                                    <field name="margin" sum="Margin"/>
                                    <field name="currency_id" invisible="1"/>
                                </list>
                            </field>
                            <group class="oe_subtotal_footer oe_right">
                                <field name="total_cost" widget="monetary"/>
                                <field name="total_price" widget="monetary"/>
                                <div class="oe_subtotal_footer_separator oe_inline">
                                    <label for="margin"/>
                                    <button name="compute_margin" string="⟳" type="object" class="oe_edit_only oe_link"/>
                                </div>
                                <field name="margin" class="oe_subtotal_footer_separator" widget="monetary" decoration-danger="margin &lt; 0" decoration-success="margin &gt; 0"/>
                                <field name="margin_percent" widget="percentage"/>
                                <field name="currency_id" invisible="1"/>
                            </group>
                        </page>
                        <page string="Work Completion" name="completion">
                            <group>
                                <field name="work_summary" widget="html" placeholder="Describe work completed..."/>
                                <field name="completion_photos" widget="many2many_binary"/>
                                <field name="customer_signature" widget="signature"/>
                                <field name="customer_feedback"/>
                            </group>
                        </page>
<!--                        <page string="Materials Used" name="materials" attrs="{'invisible': [('material_line_ids', '=', [])]}">-->
<!--                            <field name="material_line_ids">-->
<!--                                <tree editable="bottom">-->
<!--                                    <field name="product_id" domain="[('type', '=', 'product')]"/>-->
<!--                                    <field name="quantity"/>-->
<!--                                    <field name="uom_id"/>-->
<!--                                    <field name="unit_cost"/>-->
<!--                                    <field name="subtotal"/>-->
<!--                                </tree>-->
<!--                            </field>-->
<!--                        </page>-->
                        <page string="Notes">
                            <field name="notes" placeholder="Additional notes..."/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

