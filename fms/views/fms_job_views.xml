<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Job List View -->
    <record id="view_fms_job_list" model="ir.ui.view">
        <field name="name">fms.job.list</field>
        <field name="model">fms.job</field>
        <field name="arch" type="xml">
            <list string="Jobs"
                  decoration-success="state=='completed'"
                  decoration-info="state in ['assigned','scheduled']">
                <field name="name"/>
                <field name="ticket_id"/>
                <field name="partner_id"/>
                <field name="site_id"/>
                <field name="vendor_id"/>
                <field name="scheduled_date"/>
                <field name="total_cost" sum="Total Cost"/>
                <field name="total_price" sum="Total Price"/>
                <field name="margin" sum="Margin"
                       decoration-danger="margin &lt; 0"
                       decoration-success="margin &gt; 0"/>
                <field name="margin_percent" widget="percentage"/>
                <field name="state"/>
                <field name="sla_rule_id"/>
                <field name="sla_response_deadline"/>
                <field name="sla_resolution_deadline"/>
                <field name="sla_breached"/>
                <field name="currency_id" invisible="1"/>
            </list>
        </field>
    </record>

    <!-- Job Form View -->
    <record id="view_fms_job_form" model="ir.ui.view">
        <field name="name">fms.job.form</field>
        <field name="model">fms.job</field>
        <field name="arch" type="xml">
            <form string="Job">
                <header>
                    <button name="action_assign"
                            string="Assign"
                            type="object"
                            class="btn-secondary"
                            invisible="state != 'draft'"/>
                    <button name="action_schedule"
                            string="Schedule"
                            type="object"
                            class="btn-secondary"
                            invisible="state not in ('draft', 'assigned')"/>
                    <button name="action_start"
                            string="Start"
                            type="object"
                            class="btn-primary"
                            invisible="state not in ('assigned', 'scheduled')"/>
                    <button name="action_complete"
                            string="Mark as Completed"
                            type="object"
                            class="btn-primary"
                            invisible="state not in ('draft', 'assigned', 'scheduled', 'in_progress')"/>
                    <button name="action_cancel"
                            string="Cancel"
                            type="object"
                            class="btn-danger"
                            invisible="state in ('invoiced', 'cancelled')"/>
                    <button name="action_reset_draft"
                            string="Reset to Draft"
                            type="object"
                            invisible="state not in ('cancelled', 'assigned', 'scheduled')"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,assigned,in_progress,completed,invoiced"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_sale_orders"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-shopping-cart">
                            <field name="sale_order_count"
                                   widget="statinfo"
                                   string="Sales Orders"/>
                        </button>

                        <button name="action_view_tasks"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-tasks">

                            <field name="task_count"
                                   widget="statinfo"
                                   string="Tasks"/>
                        </button>

                        <button name="action_view_purchase_orders"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-shopping-basket">
                            <field name="purchase_order_count"
                                   widget="statinfo"
                                   string="Vendor POs"/>
                        </button>
                        <button name="action_view_invoice"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-file-text-o">
                            <field name="invoice_id"
                                   widget="statinfo"
                                   string="Invoice"/>
                        </button>
                        <button name="action_view_scope_approvals"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-check-circle"
                                invisible="scope_approval_count == 0">
                            <field name="scope_approval_count"
                                   widget="statinfo"
                                   string="Approvals"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only"/>
                        <h1>
                            <field name="name"
                                   readonly="1"
                                   class="text-primary"
                                   widget="copyclipboard"
                                   placeholder="Job Number"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="ticket_id"/>
                            <field name="partner_id"/>
                            <field name="site_id"/>
                            <field name="service_category_id"/>
                        </group>
                        <group>
                            <field name="vendor_id"/>
                            <field name="assigned_user_id"/>
                            <field name="scheduled_date"/>
                            <field name="start_date"/>
                            <field name="end_date"/>
                        </group>
                    </group>
                    <group string="SLA Information">
                        <group>
                            <field name="sla_rule_id" readonly="1"/>
                            <field name="sla_start_datetime" readonly="1"/>
                        </group>
                        <group>
                            <field name="sla_response_deadline" readonly="1"/>
                            <field name="sla_resolution_deadline" readonly="1"/>
                            <field name="sla_breached" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Job Details" name="job_lines">
                            <field name="job_line_ids">
                                <list editable="bottom">
                                    <field name="product_id"/>
                                    <field name="description"/>
                                    <field name="quantity"/>
                                    <field name="uom_id"/>
                                    <field name="unit_cost"/>
                                    <field name="subtotal_cost" sum="Total Cost"/>
                                    <field name="unit_price"/>
                                    <field name="subtotal_price" sum="Total Price"/>
                                    <field name="margin" sum="Margin"/>
                                    <field name="line_type"
                                           widget="badge"
                                           decoration-info="line_type=='original'"
                                           decoration-warning="line_type=='additional'"
                                           readonly="1"/>
                                    <field name="scope_state"
                                           widget="badge"
                                           decoration-muted="scope_state=='na'"
                                           decoration-warning="scope_state=='pending'"
                                           decoration-success="scope_state=='approved'"
                                           decoration-danger="scope_state=='rejected'"
                                           readonly="1"/>
                                    <field name="currency_id" invisible="1"/>
                                </list>
                            </field>
                            <group class="oe_subtotal_footer oe_right">
                                <field name="total_cost" widget="monetary"/>
                                <field name="total_price" widget="monetary"/>
                                <div class="oe_subtotal_footer_separator oe_inline">
                                    <label for="margin"/>
                                    <button name="compute_margin"
                                            string="⟳"
                                            type="object"
                                            class="oe_edit_only oe_link"/>
                                </div>
                                <field name="margin"
                                       class="oe_subtotal_footer_separator"
                                       widget="monetary"
                                       decoration-danger="margin &lt; 0"
                                       decoration-success="margin &gt; 0"/>
                                <field name="margin_percent" widget="percentage"/>
                                <field name="currency_id" invisible="1"/>
                            </group>
                        </page>
                        <page string="Work Completion" name="completion">
                            <group>
                                <field name="work_summary"
                                       widget="html"
                                       placeholder="Describe work completed..."/>
                                <field name="completion_photos"
                                       widget="many2many_binary"/>
                                <field name="customer_signature"
                                       widget="signature"/>
                                <field name="customer_feedback"/>
                            </group>
                        </page>
                        <page string="Notes">
                            <field name="notes"
                                   placeholder="Additional notes..."/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_fms_job" model="ir.actions.act_window">
        <field name="name">Jobs</field>
        <field name="res_model">fms.job</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Add your first job</p>
        </field>
    </record>
</odoo>