<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_fms_consolidated_invoice_form" model="ir.ui.view">
        <field name="name">fms.consolidated.invoice.form</field>
        <field name="model">fms.consolidated.invoice</field>
        <field name="arch" type="xml">
            <form string="Consolidated Invoice">
                <header>
                    <button name="action_collect_jobs"
                            string="Collect Jobs"
                            type="object"
                            class="btn-secondary"
                            invisible="state != 'draft'"/>
                    <button name="action_confirm"
                            string="Confirm"
                            type="object"
                            class="btn-primary"
                            invisible="state != 'draft'"/>
                    <button name="action_generate_invoice"
                            string="Generate Invoice"
                            type="object"
                            class="btn-primary"
                            invisible="state != 'confirmed'"/>
                    <button name="action_view_invoice"
                            string="View Invoice"
                            type="object"
                            class="btn-secondary"
                            invisible="not invoice_id"/>
                    <button name="action_cancel"
                            string="Cancel"
                            type="object"
                            class="btn-danger"
                            invisible="state in ('invoiced', 'cancelled')"/>
                    <button name="action_reset_draft"
                            string="Reset to Draft"
                            type="object"
                            invisible="state not in ('confirmed', 'cancelled')"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,confirmed,invoiced"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Customer &amp; Period">
                            <field name="partner_id"
                                   readonly="state != 'draft'"/>
                            <field name="site_id"
                                   domain="[('partner_id','=',partner_id)]"
                                   readonly="state != 'draft'"/>
                            <field name="contract_ref"
                                   readonly="state != 'draft'"/>
                        </group>
                        <group string="Billing Details">
                            <field name="billing_frequency"
                                   readonly="state != 'draft'"/>
                            <field name="date_from"
                                   readonly="state != 'draft'"/>
                            <field name="date_to"
                                   readonly="state != 'draft'"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="total_amount" widget="monetary"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Summary Lines">
                            <field name="line_ids">
                                <list editable="bottom">
                                    <field name="product_id"/>
                                    <field name="name"/>
                                    <field name="quantity"/>
                                    <field name="ticket_count" string="# Job Lines"/>
                                    <field name="subtotal" widget="monetary"/>
                                    <field name="currency_id" column_invisible="1"/>
                                </list>
                            </field>
                        </page>
                        <page string="Source Jobs">
                            <field name="job_ids">
                                <list>
                                    <field name="name"/>
                                    <field name="ticket_id"/>
                                    <field name="partner_id"/>
                                    <field name="site_id"/>
                                    <field name="scheduled_date"/>
                                    <field name="total_price" string="Job Total"/>
                                    <field name="state"/>
                                </list>
                            </field>
                        </page>
                        <page string="Invoice Info" invisible="not invoice_id">
                            <group>
                                <field name="invoice_id"/>
                                <field name="invoice_state"/>
                                <field name="attachment_id"/>
                            </group>
                        </page>
                        <page string="Notes">
                            <field name="notes" placeholder="Internal notes..."/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_fms_consolidated_invoice_list" model="ir.ui.view">
        <field name="name">fms.consolidated.invoice.list</field>
        <field name="model">fms.consolidated.invoice</field>
        <field name="arch" type="xml">
            <list string="Consolidated Invoices"
                  decoration-success="state == 'invoiced'"
                  decoration-info="state == 'confirmed'"
                  decoration-muted="state == 'cancelled'">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="billing_frequency"/>
                <field name="date_from"/>
                <field name="date_to"/>
                <field name="site_id"/>
                <field name="total_amount" widget="monetary"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="invoice_id"/>
                <field name="invoice_state" optional="show"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'invoiced'"
                       decoration-info="state == 'confirmed'"
                       decoration-warning="state == 'draft'"/>
            </list>
        </field>
    </record>

    <record id="view_fms_consolidated_invoice_search" model="ir.ui.view">
        <field name="name">fms.consolidated.invoice.search</field>
        <field name="model">fms.consolidated.invoice</field>
        <field name="arch" type="xml">
            <search string="Search Consolidated Invoices">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="contract_ref"/>
                <separator/>
                <filter string="Draft" name="draft"
                        domain="[('state','=','draft')]"/>
                <filter string="Confirmed" name="confirmed"
                        domain="[('state','=','confirmed')]"/>
                <filter string="Invoiced" name="invoiced"
                        domain="[('state','=','invoiced')]"/>
                <separator/>
                <filter string="Monthly" name="monthly"
                        domain="[('billing_frequency','=','monthly')]"/>
                <filter string="Weekly" name="weekly"
                        domain="[('billing_frequency','=','weekly')]"/>
                <filter string="On-Demand" name="on_demand"
                        domain="[('billing_frequency','=','on_demand')]"/>
                <separator/>
                <filter string="Group by Customer" name="group_partner"
                        context="{'group_by': 'partner_id'}"/>
                <filter string="Group by Frequency" name="group_freq"
                        context="{'group_by': 'billing_frequency'}"/>
                <filter string="Group by Status" name="group_state"
                        context="{'group_by': 'state'}"/>
                <filter string="Group by Period" name="group_month"
                        context="{'group_by': 'date_from:month'}"/>
            </search>
        </field>
    </record>

    <record id="action_fms_consolidated_invoice" model="ir.actions.act_window">
        <field name="name">Consolidated Invoices</field>
        <field name="res_model">fms.consolidated.invoice</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id"
               ref="view_fms_consolidated_invoice_search"/>
        <field name="context">{'search_default_draft': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No consolidated invoices yet.
            </p>
            <p>
                Use the <b>Billing Run</b> wizard to automatically collect
                completed jobs and create consolidated invoices per customer.
            </p>
        </field>
    </record>

</odoo>