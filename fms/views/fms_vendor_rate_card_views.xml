<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- List View -->
    <record id="fms_vendor_rate_card_list" model="ir.ui.view">
        <field name="name">Vendor Rate Card List</field>
        <field name="model">fms.vendor.rate.card</field>
        <field name="arch" type="xml">
            <list>
                <field name="vendor_id"/>
                <field name="product_id"/>
                <field name="unit_cost"/>
                <field name="currency_id"/>
                <field name="valid_from"/>
                <field name="valid_to"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="fms_vendor_rate_card_form" model="ir.ui.view">
        <field name="name">Vendor Rate Card Form</field>
        <field name="model">fms.vendor.rate.card</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="vendor_id"/>
                            <field name="product_id"/>
                        </group>
                        <group>
                            <field name="unit_cost"/>
                            <field name="currency_id"/>
                        </group>
                        <group>
                            <field name="valid_from"/>
                            <field name="valid_to"/>
                        </group>
                        <group>
                            <field name="active"/>
                        </group>
                    </group>
                    <group string="Additional Information">
                        <field name="notes" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="action_fms_vendor_rate_card" model="ir.actions.act_window">
        <field name="name">Vendor Rate Cards</field>
        <field name="res_model">fms.vendor.rate.card</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a vendor rate card to manage vendor pricing
            </p>
        </field>
    </record>

</odoo>