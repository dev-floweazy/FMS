    <!-- Rate Card Action -->
    <record id="action_fms_rate_card" model="ir.actions.act_window">
        <field name="name">Rate Cards</field>
        <field name="res_model">fms.rate.card</field>
        <field name="view_mode">list,form</field>
<!--        <field name="context">{'search_default_active_rates': 1}</field>-->
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first rate card
            </p>
            <p>
                Rate cards define customer-specific pricing for services.
                This allows you to maintain different rates for different customers.
            </p>
        </field>
