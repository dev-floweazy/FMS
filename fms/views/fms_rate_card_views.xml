<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- =====================================================
        LIST VIEW
    ====================================================== -->

    <record id="view_fms_rate_card_list" model="ir.ui.view">
        <field name="name">fms.rate.card.list</field>
        <field name="model">fms.rate.card</field>
        <field name="arch" type="xml">
            <list string="Customer Rate Cards" default_order="valid_from desc">

                <field name="partner_id"/>
                <field name="product_id"/>
                <field name="unit_price"/>
                <field name="currency_id" invisible="1"/>
                <field name="valid_from"/>
                <field name="valid_to"/>
                <field name="is_special_rate"/>

            </list>
        </field>
    </record>


    <!-- =====================================================
        FORM VIEW
    ====================================================== -->

    <record id="view_fms_rate_card_form" model="ir.ui.view">
        <field name="name">fms.rate.card.form</field>
        <field name="model">fms.rate.card</field>
        <field name="arch" type="xml">
            <form string="Customer Rate Card">

                <sheet>

                    <div class="oe_title">
                        <h1>
                            <field name="product_id" placeholder="Service"/>
                        </h1>
                    </div>

                    <group col="4">

                        <!-- IMPORTANT: & must be written as &amp; -->

                        <group string="Customer &amp; Service">
                            <field name="partner_id"/>
                            <field name="product_id"/>
                        </group>

                        <group string="Pricing">
                            <field name="unit_price"/>
                            <field name="currency_id"
                                   groups="base.group_multi_currency"/>
                        </group>

                    </group>

                    <group string="Validity" col="4">
                        <field name="valid_from"/>
                        <field name="valid_to"/>
                        <field name="is_special_rate"/>
                    </group>

                    <group string="Notes">
                        <field name="notes" nolabel="1"/>
                    </group>

                </sheet>

            </form>
        </field>
    </record>


    <!-- =====================================================
        ACTION
    ====================================================== -->

    <record id="action_fms_rate_card" model="ir.actions.act_window">
        <field name="name">Customer Rate Cards</field>
        <field name="res_model">fms.rate.card</field>
        <field name="view_mode">list,form</field>
    </record>


</odoo>
