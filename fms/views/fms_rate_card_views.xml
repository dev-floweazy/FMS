<?xml version="1.0" encoding="utf-8"?>
<odoo>
<!-- ============================================ -->
    <!-- RATE CARD VIEWS -->
    <!-- ============================================ -->

    <record id="view_fms_rate_card_list" model="ir.ui.view">
        <field name="name">fms.rate.card.list</field>
        <field name="model">fms.rate.card</field>
        <field name="arch" type="xml">
            <list string="Rate Cards" editable="bottom">
                <field name="partner_id" readonly="1"/>
<!--                <field name="product_id" domain="[('is_fms_service', '=', True)]"/>-->
                <field name="unit_price" widget="monetary"/>
                <field name="currency_id" invisible="1"/>
                <field name="valid_from"/>
                <field name="valid_to"/>
                <field name="is_special_rate"/>
                <field name="notes"/>
            </list>
        </field>
    </record>

    <record id="view_fms_rate_card_form" model="ir.ui.view">
        <field name="name">fms.rate.card.form</field>
        <field name="model">fms.rate.card</field>
        <field name="arch" type="xml">
            <form string="Rate Card">
                <sheet>
                    <group>
                        <group>
                            <field name="partner_id"/>
<!--                            <field name="product_id" domain="[('is_fms_service', '=', True)]"/>-->
                            <field name="unit_price" widget="monetary"/>
                            <field name="currency_id"/>
                        </group>
                        <group>
                            <field name="valid_from"/>
                            <field name="valid_to"/>
                            <field name="is_special_rate"/>
                        </group>
                    </group>
                    <group>
                        <field name="notes" placeholder="Rate card notes..."/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

