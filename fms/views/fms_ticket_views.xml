<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================ -->
    <!-- FMS TICKET VIEWS -->
    <!-- ============================================ -->

    <!-- Ticket List View -->
    <record id="view_fms_ticket_list" model="ir.ui.view">
        <field name="name">fms.ticket.list</field>
        <field name="model">fms.ticket</field>
        <field name="arch" type="xml">
            <list string="Tickets" decoration-danger="priority=='3'" decoration-warning="priority=='2'">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="site_id"/>
                <field name="service_category_id"/>
                <field name="priority" widget="priority"/>
                <field name="requested_date"/>
                <field name="sla_deadline" decoration-danger="sla_deadline &lt; current_date"/>
                <field name="assigned_to_id"/>
                <field name="state" decoration-success="state=='closed'" decoration-info="state in ['open','assigned']" decoration-muted="state=='cancelled'"/>
            </list>
        </field>
    </record>

    <!-- Ticket Form View -->
    <record id="view_fms_ticket_form" model="ir.ui.view">
        <field name="name">fms.ticket.form</field>
        <field name="model">fms.ticket</field>
        <field name="arch" type="xml">
            <form string="Ticket">
                <header>
<!--                    states="draft" -->
                    <button name="action_open" string="Open Ticket" type="object" class="oe_highlight"/>
<!--                     states="open"-->
                    <button name="action_assign" string="Assign" type="object" class="oe_highlight"/>
<!--                    states="assigned"-->
                    <button name="action_start" string="Start Work" type="object" />
<!--                     states="in_progress"-->
                    <button name="action_resolve" string="Mark Resolved" type="object" class="oe_highlight"/>
<!--                     states="resolved"-->
                    <button name="action_close" string="Close" type="object"/>
<!--                     states="draft,open,assigned"-->
                    <button name="action_cancel" string="Cancel" type="object" confirm="Are you sure you want to cancel this ticket?"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,open,assigned,in_progress,resolved,closed"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_jobs" type="object" class="oe_stat_button" icon="fa-tasks">
                            <field name="job_count" widget="statinfo" string="Jobs"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="partner_id" options="{'no_create': True}"/>
                            <field name="site_id" domain="[('partner_id', '=', partner_id)]" context="{'default_partner_id': partner_id}"/>
                            <field name="contact_person"/>
                            <field name="contact_phone"/>
                        </group>
                        <group>
                            <field name="service_category_id"/>
                            <field name="priority" widget="priority"/>
                            <field name="requested_date"/>
                            <field name="sla_deadline" invisible="not sla_deadline"/>
                            <field name="assigned_to_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Description">
                            <field name="description" widget="html" placeholder="Describe the issue in detail..."/>
                        </page>
                        <page string="Jobs" name="jobs">
<!--                            context="{'default_ticket_id': active_id}"-->
                            <field name="job_ids" >
                                <list decoration-success="state=='completed'" decoration-muted="state=='cancelled'">
                                    <field name="name"/>
                                    <field name="vendor_id"/>
                                    <field name="scheduled_date"/>
                                    <field name="total_price" sum="Total"/>
                                    <field name="total_cost" sum="Cost"/>
                                    <field name="margin" sum="Margin"/>
                                    <field name="margin_percent" widget="percentage"/>
                                    <field name="state"/>
                                </list>
                            </field>
                        </page>
                        <page string="Attachments">
                            <field name="attachment_ids" widget="many2many_binary"/>
                        </page>
                        <page string="Internal Notes">
                            <field name="internal_notes" placeholder="Internal notes not visible to customer..."/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

